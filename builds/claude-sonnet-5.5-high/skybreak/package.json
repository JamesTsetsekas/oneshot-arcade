  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
