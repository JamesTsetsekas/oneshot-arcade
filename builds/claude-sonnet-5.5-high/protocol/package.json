{
  "name": "last-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Last Protocol - original browser tactical FPS vertical slice (Cipher Breach on Aperture Annex)",
  "scripts": {
    "dev": "vite --port 5530 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5531 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "tsx tools/scan-map.ts",
    "capture": "node tools/capture.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
