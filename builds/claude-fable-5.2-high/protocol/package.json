{
  "name": "last-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Last Protocol - browser tactical FPS vertical slice (Oneshot Arcade)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5330 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5331 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshot": "node tools/screenshot.mjs",
    "verify:browser": "node tools/playtest.mjs",
    "probe:balance": "vitest run --config tools/probes/vitest.config.ts balance"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
