{
  "name": "meridian-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meridian Run - an original browser open-world urban action sandbox (vertical slice).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5360 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5361 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
