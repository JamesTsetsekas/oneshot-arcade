{
  "name": "ashfall-covenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5310 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5311 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "vitest run --mode probe",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
