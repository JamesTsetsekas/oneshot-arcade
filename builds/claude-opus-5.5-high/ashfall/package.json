{
  "name": "ashfall-covenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ashfall Covenant - an original isometric browser action RPG vertical slice",
  "scripts": {
    "dev": "vite --port 5410 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5411 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.8",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
