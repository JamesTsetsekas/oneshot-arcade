{
  "name": "crownfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crownfall - a browser 3v3 lane-and-objective MOBA vertical slice",
  "scripts": {
    "dev": "vite --port 5440 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5441 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
