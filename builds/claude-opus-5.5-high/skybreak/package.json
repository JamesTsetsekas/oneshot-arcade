{
  "name": "skybreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5450 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5451 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "shot": "node scripts/screenshot.mjs",
    "soak": "vitest run --config vitest.dev.config.ts tests/dev/sim.dev.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "1.49",
    "typescript": "5.6",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
