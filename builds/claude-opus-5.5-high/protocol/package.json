{
  "name": "last-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Last Protocol - browser 5v5 tactical shooter vertical slice (Cipher Breach on Aperture Annex)",
  "scripts": {
    "dev": "vite --port 5430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5431 --strictPort",
